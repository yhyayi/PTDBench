# openrsi_reward_direction — RL launch configuration.
#
# Derived from configs/async_single_node.env.example, pinned to this task's
# small-batch shape and to a Qwen3-4B dense policy on a CPU sandbox fleet.
#
# Values marked TODO(env) must be filled in by the experiment runner:
# paths to the prepared assets, and the sandbox/judge endpoints for the target
# cluster.
#
# Validate wiring without launching training:
#   PRECHECK_ONLY=1 bash examples/openmle_rl/scripts/run_openrsi_reward_direction.sh <this file>

# --- data -------------------------------------------------------------------
PROMPT_DATA="/path/to/openmle_rl_train.parquet"            # TODO(env)
EVAL_PROMPT_DATA="/path/to/openmle_rl_eval.parquet"        # TODO(env)
LEADERBOARD_ROOTS="/path/to/public_leaderboards"           # TODO(env)
REQUIRE_ALL_PUBLIC_LEADERBOARDS=1

# --- model ------------------------------------------------------------------
MODEL_CONFIG="${OPS_DIR}/model_configs/qwen3-4B-Thinking-2507.sh"
HF_CHECKPOINT="/path/to/qwen3-4B-Thinking-2507-hf"         # TODO(env)
REF_LOAD="/path/to/qwen3-4B-Thinking-2507-megatron"        # TODO(env)
REF_CKPT_STEP=""

# --- sandbox ----------------------------------------------------------------
# SANDBOX_MODE must stay "remote": the local sandbox contract is not released.
SANDBOX_MODE="remote"
SANDBOX_BASE_URL="https://sandbox.example.org"             # TODO(env)
SANDBOX_API_KEY="your-sandbox-api-key"                     # TODO(env)
HF_ENDPOINT="https://hf-mirror.com"
GPT_BASE_URL="https://llm-api.example.org/v1"              # TODO(env)
GPT_API_KEY="your-gpt-api-key"                             # TODO(env)

# Must match the CPU worker count. The example ships 128, which queues jobs far
# past SANDBOX_MAX_WAIT_TIMEOUT and scores them as wait_timeout (silent zeros).
SANDBOX_CONCURRENCY=16
HACK_CHECK_CONCURRENCY=16
JOB_TIMEOUT=600
WAIT_TIMEOUT=1200
EVAL_JOB_TIMEOUT=1200
EVAL_WAIT_TIMEOUT=2400
SANDBOX_MAX_JOB_TIMEOUT=3600
SANDBOX_MAX_WAIT_TIMEOUT=3900

# --- run --------------------------------------------------------------------
OUTPUT_ROOT="${SLIME_ROOT}/outputs/openmle_rl"
WANDB_KEY="ptdbench-offline"
WANDB_PROJECT="openrsi-reward-direction"
WANDB_MODE="offline"
EXPERIMENT_ID="openrsi_reward_direction"
NUM_ROLLOUT=40
SAVE_INTERVAL=10
SAVE_DB_SNAPSHOTS=1
SLIME_DISABLE_SAVE=0

# --- batch shape (the launcher enforces this derivation as a hard exit) -----
ROLLOUT_BATCH_SIZE=8
N_SAMPLES_PER_PROMPT=8
NUM_STEPS_PER_ROLLOUT=1
GLOBAL_BATCH_SIZE=64
ROLLOUT_MAX_RESPONSE_LEN=24576
EVAL_INTERVAL=5
N_SAMPLES_PER_EVAL_PROMPT=1
EVAL_MAX_RESPONSE_LEN=32768
EVAL_TEMPERATURE=0.7
EVAL_TOP_P=0.95
EVAL_BEFORE_TRAIN=0
ALGO_VARIANT="gspo"
LR="1e-6"

# --- topology: one 8-GPU node, 4 train + 4 rollout --------------------------
ACTOR_NUM_NODES=1
ACTOR_NUM_GPUS_PER_NODE=4
ROLLOUT_NUM_GPUS=4
RAY_NUM_GPUS_PER_NODE=8
TENSOR_MODEL_PARALLEL_SIZE=1
PIPELINE_MODEL_PARALLEL_SIZE=1
CONTEXT_PARALLEL_SIZE=1
EXPERT_MODEL_PARALLEL_SIZE=1
ROLLOUT_NUM_GPUS_PER_ENGINE=1
SGLANG_MEM_FRACTION_STATIC=0.70
SOCKET_IFNAME="eth0"
CLEANUP_EXISTING_RAY=0

# --- reward -----------------------------------------------------------------
# These are the knobs the injected defect interacts with. Keep them at the
# released defaults so the staged bug is the only variable.
REWARD_VARIANT="newreward"
TEMPERATURE=1
USE_SCORE2REWARD=1
REWARD_MAPPING_MODE="power_clip"
STATIC_REWARD_MAPPING_MODE="power_clip"
POWER_CLIP_ALPHA=1
ENABLE_DYNAMIC_SCORE_BOUNDS=1
ADAPTIVE_REWARD_BOUND_MODE="top1_top8"
ADAPTIVE_REWARD_BOUND_LOWER_SHIFT_RATIO=0.25
ADAPTIVE_BOUND_SINGLE_FINITE_REWARD_ONE=1
DYNAMIC_SCORE_BOUND_MIN_SPAN="1e-6"
USE_TTT_DISCOVER_ADVANTAGE=1
ENABLE_SELF_VALIDATION=1
IMPROVE_REWARD_STRATEGY="base"
IMPROVE_DELTA_BONUS_COEF=0.5
DRAFT_PROBABILITY=0.50
IMPROVE_PROBABILITY=0.17
DEBUG_PROBABILITY=0.17
CROSSOVER_PROBABILITY=0.16
SEARCH_ALGORITHM="evo"

# --- diagnostics ------------------------------------------------------------
USE_PROXY_SANDBOX=0
ENABLE_PROMPT_DUMP=0
PROMPT_DUMP_BASE_DIR="${OUTPUT_ROOT}/prompt_dumps"
PROMPT_DUMP_RUN_SUBDIR=""
EVAL_GENERATION_ABORT_MAX_RETRIES=60
EVAL_GENERATION_ABORT_RETRY_SLEEP=1
AIRAEVO_MEMORY_LLM_URL=""
METRIC_STATIC_BOUND_USE_CONST_FALLBACK=1
METRIC_STATIC_FALLBACK_SIGNED_BEST=100
METRIC_STATIC_FALLBACK_SIGNED_WORST=-100
VALIDATION_TEST_GAP_PENALTY_PIECEWISE_ENABLED=1
VALIDATION_TEST_GAP_PENALTY_COEF=1
VALIDATION_TEST_GAP_PENALTY_HIGH_COEF=2
VALIDATION_TEST_GAP_PENALTY_TOLERANCE=0

# --- resume -----------------------------------------------------------------
RESUME_MODEL_PATH=""
RESUME_CKPT_STEP=""
LOAD_OPTIMIZER=0
LOAD_RNG=0
MANUAL_DB_PATH=""
