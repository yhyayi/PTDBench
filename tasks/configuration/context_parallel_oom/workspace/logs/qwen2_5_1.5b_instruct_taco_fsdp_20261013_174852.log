[36m(TaskRunner pid=8432)[0m [code] def numberOfPaths(m, n):
[36m(TaskRunner pid=8432)[0m     MOD = 1000000007
[36m(TaskRunner pid=8432)[0m     dp = [[1 for _ in range(n)] for _ in range(m)]
[36m(TaskRunner pid=8432)[0m     for i in range(1, m):
[36m(TaskRunner pid=8432)[0m         for j in range(1, n):
[36m(TaskRunner pid=8432)[0m             dp[i][j] = (dp[i-1][j] + dp[i][j-1]) % MOD
[36m(TaskRunner pid=8432)[0m     return dp[-1][-1] % MOD
