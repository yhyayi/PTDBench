[36m(TaskRunner pid=8432)[0m def min_possible_value(N, K):
[36m(TaskRunner pid=8432)[0m     # If K is less than N, the minimum value N can take after zero or more operations is K
[36m(TaskRunner pid=8432)[0m     if K < N:
[36m(TaskRunner pid=8432)[0m         return K
[36m(TaskRunner pid=8432)[0m 
[36m(TaskRunner pid=8432)[0m     # Start from sqrt(N), as the absolute difference operation is halved each time
[36m(TaskRunner pid=8432)[0m     i = math.isqrt(N)
[36m(TaskRunner pid=8432)[0m     result = N
[36m(TaskRunner pid=8432)[0m 
[36m(TaskRunner pid=8432)[0m     while i >= 1:
[36m(TaskRunner pid=8432)[0m         # If the absolute difference is less than N, update N to the new value
[36m(TaskRunner pid=8432)[0m         if abs(N - i * K) < N:
[36m(TaskRunner pid=8432)[0m             N = abs(N - i * K)
[36m(TaskRunner pid=8432)[0m         # If the difference is equal or greater, decrease N by the absolute difference
[36m(TaskRunner pid=8432)[0m         elif abs(N - i * K) == N:
[36m(TaskRunner pid=8432)[0m             N -= abs(N - i * K)
[36m(TaskRunner pid=8432)[0m         # If the difference is less, increase N by the absolute difference
[36m(TaskRunner pid=8432)[0m         elif abs(N - i * K) < N:
[36m(TaskRunner pid=8432)[0m             N += abs(N - i * K)
[36m(TaskRunner pid=8432)[0m         # Each iteration, safely decrease i by 1
[36m(TaskRunner pid=8432)[0m         i -= 1
[36m(TaskRunner pid=8432)[0m 
[36m(TaskRunner pid=8432)[0m     return N
[36m(TaskRunner pid=8432)[0m 
[36m(TaskRunner pid=8432)[0m # Example usage
