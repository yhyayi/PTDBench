# PTDBench environment `rank-distillation-cpu`.
# ptdbench-image: ptdbench/rank-distillation-cpu:torch2.13-cpu-py3.12
#
# CPU-only Python 3.12 slim environment for the ptdbench_rank_distillation_collapse
# issue task.  No GPU, no CUDA required.
#
# Issue profile installs: torch 2.13.0+cpu, numpy 1.26.4, PyYAML 6.0.3, and the
# full CPU test suite (pytest, tensordict, omegaconf, transformers, tokenizers,
# safetensors, huggingface-hub, regex, requests, tqdm + transitive deps).  The
# agent can import torch, run the workspace test_opd_*_on_cpu.py tests, and do
# CPU tensor probes without any GPU driver present.
#
# GPU training profile is NOT baked here; it requires Linux x86_64 + CUDA 13 and
# is driven by prepare.sh with PTDBENCH_PREPARE_PROFILE=training.
#
# The workspace verl source is NOT baked here: the harness bind-mounts each task's
# workspace at /workspace, and PYTHONPATH=/workspace/verl (written to prepared/env
# by prepare.sh) makes `import verl` resolve to that source.
#
# Changing the FROM digest is a deliberate upgrade -- re-run the task on this
# environment afterward.
FROM python:3.12.12-slim@sha256:f3fa41d74a768c2fce8016b98c191ae8c1bacd8f1152870a3f9f87d350920b7c

ARG DEBIAN_FRONTEND=noninteractive

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# All experiment Python packages live in this virtual environment.
RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/python --version && \
    /opt/venv/bin/python -m pip --version

RUN python -m pip config set global.index-url \
        https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple && \
    python -m pip install --upgrade pip setuptools wheel

# CPU PyTorch 2.13.0 + issue test suite.
# Packages and hashes compiled with:
#   uv pip compile environment/requirements.in --python-version 3.12
#     --python-platform x86_64-unknown-linux-gnu
#     --extra-index-url https://download.pytorch.org/whl/cpu
#     --index-strategy unsafe-best-match --generate-hashes
# Inline (not COPY'd): docker/.dockerignore allowlists only ptdbench-activate.sh,
# so requirements must be inlined.  Same pattern as vllm0.11.0-torch2.8.0-flashattn2.8.3-cu128-py3.12.Dockerfile.
RUN python -m pip install --extra-index-url https://download.pytorch.org/whl/cpu \
        --index-strategy unsafe-best-match \
        --require-hashes \
        -r /dev/stdin <<'REQS'
