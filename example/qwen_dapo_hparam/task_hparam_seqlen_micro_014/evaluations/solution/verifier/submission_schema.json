{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RL repair run submission",
  "type": "object",
  "required": ["run_dir", "metrics_path", "receipt_path", "log_path", "command_path", "changed_files"],
  "additionalProperties": false,
  "properties": {
    "run_dir": {"type": "string"},
    "metrics_path": {"type": "string"},
    "receipt_path": {"type": "string"},
    "log_path": {"type": "string"},
    "command_path": {"type": "string"},
    "changed_files": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
